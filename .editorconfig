root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.cs]
indent_size = 4

# Naming conventions
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# var preferences
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression body
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Namespace style
csharp_style_namespace_declarations = file_scoped:warning

# Organize usings
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true

# CA diagnostics severity overrides for warnings-as-errors
# These are the full-analysis rules enabled by AnalysisMode=All.
# Rules intentionally suppressed get a documented justification here (none yet).

# Disable IDE rules that conflict with our explicit style choices:
# IDE0005 (remove unnecessary usings) — keep as warning (it's caught by format)
dotnet_diagnostic.IDE0005.severity = warning

# IDE0008 (use explicit type) — we allow var when type is apparent
dotnet_diagnostic.IDE0008.severity = none

# IDE0130 (namespace does not match folder) — file-scoped namespaces already enforce this
dotnet_diagnostic.IDE0130.severity = warning

# IDE0010 (populate switch) — not always needed
dotnet_diagnostic.IDE0010.severity = suggestion

# IDE0072 (populate switch) — same as above
dotnet_diagnostic.IDE0072.severity = suggestion

# CA1014 (mark assemblies with CLSCompliant) — NuGet library; not applicable
dotnet_diagnostic.CA1014.severity = none

# CA2007 (ConfigureAwait) — library code; consumers set context; suppress globally
dotnet_diagnostic.CA2007.severity = none
