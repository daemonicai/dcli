<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Dcli</AssemblyName>
    <RootNamespace>Dcli</RootNamespace>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>dcli</PackageId>
    <Version>0.1.0</Version>
    <Authors>daemonicai</Authors>
    <Company>daemonicai</Company>
    <Description>Inline terminal-rendering library. Claude-Code-style styled output flows into the terminal's real scrollback, with a small interactive region pinned at the bottom.</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/daemonicai/dcli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/daemonicai/dcli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>terminal;cli;tui;rendering;ansi;vt100</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dcli.Tests" />
  </ItemGroup>

</Project>
